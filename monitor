#!/bin/bash
#
# External/builtin display switching via xrandr, with a per-Wi-Fi-network
# resolution preset for the external monitor.
#
# Override the defaults below without editing the script:
#   BUILTIN_RES         builtin panel's xrandr --mode (default: 1680x1050)
#   MONITOR_WIFI_RES     "SSID1=RES1,SSID2=RES2,..." — merged into (and
#                         overriding) the built-in WIFI_RES table
#
#   monitor external|e     turn on external display
#   monitor integrated|i   turn on builtin display (aliases: b, d)
#   monitor don             external on + builtin off, then awesome.restart()
#   monitor doff             builtin on + external off, then awesome.restart()

BUILTIN_RES=${BUILTIN_RES:-1680x1050} # native is 1920x1200, but that's too small

declare -A WIFI_RES=(
    ["KOKOT"]="1680x1050"
)

if [[ -n "$MONITOR_WIFI_RES" ]]; then
    IFS=',' read -ra _wifi_res_pairs <<< "$MONITOR_WIFI_RES"
    for _pair in "${_wifi_res_pairs[@]}"; do
        WIFI_RES["${_pair%%=*}"]="${_pair#*=}"
    done
fi

# Resolution to use for the external monitor, keyed off the active Wi-Fi
# SSID (falls back to "auto" for unknown networks, e.g. wired/unlisted).
get_external_res() {
    local CURRENT_SSID
    CURRENT_SSID=$(nmcli -t -f type,name connection show --active | grep -i wireless | cut -d':' -f2)
    echo "${WIFI_RES[$CURRENT_SSID]:-auto}"
}

EXTERNAL_RES=$(get_external_res)

# Ask the running AwesomeWM instance to restart (re-reads layout after an
# xrandr output change).
reload-awesome () {
    echo 'awesome.restart()' | awesome-client
}

# Name of the connected external output (DisplayPort/HDMI), if any.
get-ext-dev () {
    xrandr | grep -E '(^DP|HDMI).* connected' | cut -d' ' -f1
}

# Name of the connected builtin output (eDP).
get-builtin-dev () {
    xrandr | grep -E '(^eDP).* connected' | cut -d' ' -f1
}

builtin-on () {
    xrandr --output "$(get-builtin-dev)" --mode $BUILTIN_RES
}

builtin-off () {
    xrandr --output "$(get-builtin-dev)" --off
}

external-on () {
    xrandr --output "$(get-ext-dev)" --"$EXTERNAL_RES"
}

external-off () {
    xrandr --output "$(get-ext-dev)" --off
}

# Dock mode: external monitor on, builtin off — only if an external output
# is actually connected — then restart awesome so it picks up the change.
external-on-builtin-off () {
    [[ ! -z "$(get-ext-dev)" ]] && external-on && builtin-off && reload-awesome
}

# Undock mode: builtin on, external off, then restart awesome.
external-off-bulitin-on () {
    builtin-on && external-off && reload-awesome
}

case $1 in
    external) external-on; exit;;
    e) external-on; exit;;
    don) external-on-builtin-off exit;;
    doff) external-off-bulitin-on exit;;
    integrated) builtin-on; exit;;
    i) builtin-on; exit;;
    b) builtin-on; exit;;
    d) builtin-on; exit;;
esac
